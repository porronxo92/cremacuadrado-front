{
  "name": "cremacuadrado-frontend",
  "version": "1.0.0",
  "description": "Cremacuadrado E-commerce Frontend - Angular 18",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run prerender:routes && ng build",
    "build:prod": "npm run prerender:routes && ng build --configuration production",
    "build:staging": "npm run prerender:routes && ng build --configuration staging",
    "build:vercel": "node scripts/build-vercel.mjs",
    "watch": "ng build --watch --configuration development",
    "prerender:routes": "node scripts/generate-prerender-routes.mjs",
    "test": "ng test",
    "test:seo": "node seo-tests/run.mjs",
    "test:seo:build": "node seo-tests/run.mjs --build",
    "serve:ssr:cremacuadrado": "node dist/cremacuadrado/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.0.0",
    "@angular/common": "^18.0.0",
    "@angular/compiler": "^18.0.0",
    "@angular/core": "^18.0.0",
    "@angular/forms": "^18.0.0",
    "@angular/platform-browser": "^18.0.0",
    "@angular/platform-browser-dynamic": "^18.0.0",
    "@angular/platform-server": "^18.0.0",
    "@angular/router": "^18.0.0",
    "@angular/ssr": "^18.2.21",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/teko": "^5.3.0",
    "@stripe/stripe-js": "^9.8.0",
    "dompurify": "^3.4.12",
    "express": "^4.18.2",
    "marked": "^18.0.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.0.0",
    "@angular/cli": "^18.0.0",
    "@angular/compiler-cli": "^18.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "cheerio": "^1.2.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.4.0"
  }
}
