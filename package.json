{
  "name": "cremacuadrado-frontend",
  "version": "1.0.0",
  "description": "Cremacuadrado E-commerce Frontend - Angular 18",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run prerender:routes && ng build && npm run prerender:check",
    "build:prod": "npm run prerender:routes && ng build --configuration production && npm run prerender:check",
    "build:staging": "npm run prerender:routes && ng build --configuration staging && npm run prerender:check",
    "build:vercel": "node scripts/build-vercel.mjs",
    "watch": "ng build --watch --configuration development",
    "prerender:routes": "node scripts/generate-prerender-routes.mjs",
    "prerender:check": "node scripts/check-prerender.mjs",
    "test:seo": "node seo-tests/run.mjs",
    "test:seo:build": "node seo-tests/run.mjs --build",
    "serve:ssr:cremacuadrado": "node dist/cremacuadrado/server/server.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/platform-server": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/ssr": "^21.2.28",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/teko": "^5.3.0",
    "@stripe/stripe-js": "^9.8.0",
    "dompurify": "^3.4.12",
    "express": "^4.18.2",
    "leaflet": "^1.9.4",
    "marked": "^18.0.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.25",
    "@playwright/test": "1.63.0",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.17",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^18.18.0",
    "cheerio": "^1.2.0",
    "typescript": "~5.9.3"
  }
}
