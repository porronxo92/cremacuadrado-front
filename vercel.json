{
  "version": 2,
  "buildCommand": "npm run build:prod",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cremacuadrado-back.vercel.app/api/:path*"
    },
    { "source": "/", "destination": "/api" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/cremacuadrado/**"
    }
  }
}
