{
  "version": 2,
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm install",
  "framework": null,
  "redirects": [
    {
      "source": "/producto/crema-pistacho-pura-100-gr",
      "destination": "/tienda/crema-pistacho-pura",
      "permanent": true
    },
    {
      "source": "/producto/crema-pistacho-pura-100-gr/",
      "destination": "/tienda/crema-pistacho-pura",
      "permanent": true
    },
    {
      "source": "/producto/crema-pistacho-pura",
      "destination": "/tienda/crema-pistacho-pura",
      "permanent": true
    },
    {
      "source": "/producto/crema-pistacho-pura/",
      "destination": "/tienda/crema-pistacho-pura",
      "permanent": true
    },
    {
      "source": "/producto/crema-pistacho-crunchy-100-gr",
      "destination": "/tienda/crema-pistacho-crunchy",
      "permanent": true
    },
    {
      "source": "/producto/crema-pistacho-crunchy-100-gr/",
      "destination": "/tienda/crema-pistacho-crunchy",
      "permanent": true
    },
    {
      "source": "/producto/crema-pistacho-crunchy",
      "destination": "/tienda/crema-pistacho-crunchy",
      "permanent": true
    },
    {
      "source": "/producto/crema-pistacho-crunchy/",
      "destination": "/tienda/crema-pistacho-crunchy",
      "permanent": true
    },
    {
      "source": "/producto/:path*",
      "destination": "/tienda",
      "permanent": true
    },
    {
      "source": "/producto/:path*/",
      "destination": "/tienda",
      "permanent": true
    },
    {
      "source": "/categoria-producto/:path*",
      "destination": "/tienda",
      "permanent": true
    },
    {
      "source": "/categoria-producto/:path*/",
      "destination": "/tienda",
      "permanent": true
    },
    {
      "source": "/que-es-realmente-el-pistacho",
      "destination": "/el-archivo/que-es-realmente-el-pistacho",
      "permanent": true
    },
    {
      "source": "/que-es-realmente-el-pistacho/",
      "destination": "/el-archivo/que-es-realmente-el-pistacho",
      "permanent": true
    },
    {
      "source": "/pistachos-y-rendimiento-sexual",
      "destination": "/el-archivo",
      "permanent": true
    },
    {
      "source": "/pistachos-y-rendimiento-sexual/",
      "destination": "/el-archivo",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/el-archivo",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/el-archivo",
      "permanent": true
    },
    {
      "source": "/quienes-somos",
      "destination": "/nuestro-metodo",
      "permanent": true
    },
    {
      "source": "/quienes-somos/",
      "destination": "/nuestro-metodo",
      "permanent": true
    },
    {
      "source": "/nosotros",
      "destination": "/nuestro-metodo",
      "permanent": true
    },
    {
      "source": "/nosotros/",
      "destination": "/nuestro-metodo",
      "permanent": true
    },
    {
      "source": "/politica-de-privacidad",
      "destination": "/privacidad",
      "permanent": true
    },
    {
      "source": "/politica-de-privacidad/",
      "destination": "/privacidad",
      "permanent": true
    },
    {
      "source": "/politica-de-cookies",
      "destination": "/cookies",
      "permanent": true
    },
    {
      "source": "/politica-de-cookies/",
      "destination": "/cookies",
      "permanent": true
    },
    {
      "source": "/finalizar-compra",
      "destination": "/checkout",
      "permanent": true
    },
    {
      "source": "/finalizar-compra/",
      "destination": "/checkout",
      "permanent": true
    },
    {
      "source": "/mi-cuenta",
      "destination": "/account",
      "permanent": true
    },
    {
      "source": "/mi-cuenta/",
      "destination": "/account",
      "permanent": true
    },
    {
      "source": "/aviso-legal/",
      "destination": "/aviso-legal",
      "permanent": true
    },
    {
      "source": "/contacto/",
      "destination": "/contacto",
      "permanent": true
    },
    {
      "source": "/tienda/",
      "destination": "/tienda",
      "permanent": true
    },
    {
      "source": "/carrito/",
      "destination": "/carrito",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/cremacuadrado/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://*.public.blob.vercel-storage.com https://*.stripe.com https://*.googleusercontent.com https://*.basemaps.cartocdn.com; font-src 'self' data:; media-src 'self' https://*.public.blob.vercel-storage.com; connect-src 'self' https://api.cremacuadrado.com https://api-stg.cremacuadrado.com https://api.stripe.com https://accounts.google.com; frame-src https://js.stripe.com https://hooks.stripe.com https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://js.stripe.com\")"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}
